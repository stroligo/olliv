{
  "name": "olliv",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:localhost-olliv-dist": "NUXT_APP_BASE_URL=/olliv/dist/ NUXT_PUBLIC_SITE_URL=http://localhost/olliv/dist nuxt generate",
    "preview": "nuxt preview",
    "preview:output": "npx --yes serve .output/public",
    "prompts:export": "node scripts/export-prompts-from-transcript.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "nuxt": "^4.4.5",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "vite-plugin-eslint2": "^5.1.0"
  }
}
