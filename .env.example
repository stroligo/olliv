# Copie para `.env` local (não commitar) ou defina no painel de deploy quando precisar
# de override (staging, pré-visualização).
#
# Raiz ou subpasta do site (`nuxt.config` → `app.baseURL`). Omitir ou `/` = raiz do domínio.
# Em subpasta, use barras (ex.: `NUXT_APP_BASE_URL=/olliv/` quando o site público é `…/olliv/`).
#
# URL pública, sem `/` no fim — canonical, Open Graph, Twitter e JSON-LD.
# Em subpasta, inclua no URL o mesmo caminho que em `NUXT_APP_BASE_URL` (ex.: `https://exemplo.com/olliv`).
# Produção já usa `SITE_ORIGIN` por defeito em `nuxt.config`; só declare aqui para outro host.
NUXT_PUBLIC_SITE_URL=https://www.ollivpericias.com.br

# Medição (opcional em dev local — em produção já vêm dos defaults em `nuxt.config`)
# NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-FGLW3DYBEH
