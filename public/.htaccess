# Hostinger / Apache — consolidar domínio em https://www.ollivpericias.com.br
# Evita duplicidade no Search Console (apex sem www → canonical alternativa).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # ollivpericias.com.br → www.ollivpericias.com.br
  RewriteCond %{HTTP_HOST} ^ollivpericias\.com\.br$ [NC]
  RewriteRule ^ https://www.ollivpericias.com.br%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# Página 404 da OLLIV (gerada em /404/index.html pelo `nuxt generate`)
ErrorDocument 404 /404/index.html
